DATABASE_URL=postgresql://hedhog:changeme@localhost:5432/hedhog
# Secrets marked "generate" are replaced with fresh random values by
# `pnpm init:env` (runs automatically on postinstall) when apps/api/.env is
# first created. Never commit real values here.
ENCRYPTION_SECRET="generate"
JWT_SECRET="generate"
JWT_EXPIRES_IN=7d
PEPPER="generate"
CORS_ALLOWED_ORIGINS=http://localhost:3200
# Optional: trusted base domains whose subdomains (and apex) are allowed by CORS.
# Example (production): example.com,example.org
CORS_ALLOWED_DOMAINS=
# Also enables cross-pod propagation of AI prompt updates. Without it each
# process refreshes on its own version-check interval.
REDIS_URL=redis://localhost:6379
SETTINGS_VERSION_CHECK_INTERVAL_MS=5000
AI_INSTRUCTION_VERSION_CHECK_INTERVAL_MS=5000

# Shared secret for the public sites that consume the CMS. On publish the API
# calls POST {cms-site-base-url}/api/revalidate with it, dropping the page's ISR
# cache immediately. Empty = publishing only writes to the database.
CMS_REVALIDATE_SECRET=
