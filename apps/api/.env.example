DATABASE_URL=postgresql://hedhog:changeme@localhost:5432/hedhog
ENCRYPTION_SECRET="RDBJYWY2UXZWQVVJeHJ2MDREWXQwVEJVQkp6am9qbzdGUFlmSUczQllyTQ=="
JWT_SECRET=5fba2ef81e3121c215cb1a022ef0119e1b245c95a6c15640c06f4763cdc51626
JWT_EXPIRES_IN=7d
PEPPER="R2tzczBtc0NZOUhFcGN4MDBpNy1WZw=="
# A extensao de navegador (apps/hedhog-vaults-extension) sonda /setting/initial
# ANTES de pedir host permission, entao esse primeiro fetch depende do CORS.
# Origem = chrome-extension://<id fixo do manifest>. Ver o README da extensao.
CORS_ALLOWED_ORIGINS=http://localhost:3200,chrome-extension://gcjdclnalkkapoajodppjbcmifnadgok
# Optional: trusted base domains whose subdomains (and apex) are allowed by CORS.
# Example (production): hcode.com.br,hcode.training
CORS_ALLOWED_DOMAINS=
# O REDIS_URL abaixo tambem habilita a propagacao de prompts de IA entre pods.
# Sem ele, cada processo se atualiza pelos intervalos de checagem de versao.
REDIS_URL=redis://localhost:6379
SETTINGS_VERSION_CHECK_INTERVAL_MS=5000
AI_INSTRUCTION_VERSION_CHECK_INTERVAL_MS=5000

# Segredo compartilhado com os sites publicos consumidores do CMS (apps/web e
# apps/hcode-site, mesmo valor nos dois): ao publicar uma pagina, o backend
# chama POST {cms-site-base-url}/api/revalidate com este segredo pra derrubar
# o cache (ISR) da pagina na hora, sem esperar o ciclo automatico. Vazio =
# publicar so grava no banco, sem avisar o site (comportamento anterior).
CMS_REVALIDATE_SECRET=

# Desabilita a validacao do X-Hub-Signature-256 no webhook da Meta (WhatsApp).
# APENAS para desenvolvimento local, ex.: reenviar um payload salvo sem assinar.
# Ignorado quando NODE_ENV=production — em producao a assinatura nao e opcional.
WHATSAPP_WEBHOOK_SKIP_SIGNATURE=false

# --- Observabilidade (Sentry) -------------------------------------------------
# Desligado por padrao. Precisa das DUAS coisas para transmitir: SENTRY_ENABLED
# =true E um SENTRY_DSN nao vazio. O DSN NUNCA vai hardcoded no codigo.
# Projeto Sentry: org "hcode-3o", projeto "api".
SENTRY_ENABLED=false
SENTRY_DSN=
# Default: NODE_ENV. Use development | staging | production.
SENTRY_ENVIRONMENT=
# Preenchido no deploy com github.sha (mesmo padrao de apps/class no
# .github/workflows/deploy.yml). Vazio em dev = eventos sem release.
SENTRY_RELEASE=
# A MESMA imagem e deployada como hub-api / hub-queue-worker / hub-video-worker.
# Sem isto nao se separa erro de request de erro de job na busca do Sentry.
SENTRY_SERVER_NAME=api
# Fracao das requisicoes/jobs com trace (0..1). 0.05 = mesmo valor de producao.
SENTRY_TRACES_SAMPLE_RATE=1.0
# Taxa propria da fila customizada (Postgres-polling) — dessincronizada da
# taxa acima de proposito (ver docs/sentry.md).
SENTRY_TRACES_SAMPLE_RATE_QUEUE=1.0
# Profiling de CPU (0..1), avaliado UMA vez por boot do processo.
SENTRY_PROFILE_SESSION_SAMPLE_RATE=1.0
# Logs estruturados (console.warn/error viram Sentry Logs). 'false' desliga.
SENTRY_ENABLE_LOGS=true

# --- Migracao do sistema legado (Matrix/MySQL) -------------------------------
# Temporario: remover tudo abaixo no cutover, junto com a library @hed-hog-pro/legacy.
# Sem LEGACY_MYSQL_URL a feature inteira e um no-op: o login se comporta
# exatamente como antes e nenhuma conexao MySQL e aberta.
# Usar um usuario somente-leitura dedicado (GRANT SELECT), nunca o usuario da aplicacao.
# LEGACY_MYSQL_URL=mysql://hub_readonly:senha@mysql-matrix.hcode.svc.cluster.local:3306/matrix
# Com apenas a URL acima, /legacy/health e /legacy/migration/report funcionam mas
# NADA e gravado. Ligar a escrita (fallback de login, reconciliacao e backfill) e
# um passo separado e explicito do rollout:
# LEGACY_WRITES_ENABLED=false
# LEGACY_MIGRATION_ENABLED=true
# LEGACY_MYSQL_POOL_LIMIT=2
# LEGACY_ALLOWED_DOMAIN_IDS=1
