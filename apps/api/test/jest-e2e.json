{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@hed-hog/api/(.*)$": "<rootDir>/../../../packages/api/src/$1",
    "^@hed-hog/api$": "<rootDir>/../../../packages/api/src",
    "^@hed-hog/api-healthy/(.*)$": "<rootDir>/../../../packages/api-healthy/src/$1",
    "^@hed-hog/api-healthy$": "<rootDir>/../../../packages/api-healthy/src",
    "^@hed-hog/api-locale/(.*)$": "<rootDir>/../../../packages/api-locale/src/$1",
    "^@hed-hog/api-locale$": "<rootDir>/../../../packages/api-locale/src",
    "^@hed-hog/api-mail/(.*)$": "<rootDir>/../../../packages/api-mail/src/$1",
    "^@hed-hog/api-mail$": "<rootDir>/../../../packages/api-mail/src",
    "^@hed-hog/api-pagination/(.*)$": "<rootDir>/../../../packages/api-pagination/src/$1",
    "^@hed-hog/api-pagination$": "<rootDir>/../../../packages/api-pagination/src",
    "^@hed-hog/api-prisma/(.*)$": "<rootDir>/../../../packages/api-prisma/src/$1",
    "^@hed-hog/api-prisma$": "<rootDir>/../../../packages/api-prisma/src",
    "^@hed-hog/api-types/(.*)$": "<rootDir>/../../../packages/api-types/src/$1",
    "^@hed-hog/api-types$": "<rootDir>/../../../packages/api-types/src",
    "^@hed-hog/vault-crypto$": "<rootDir>/../../../packages/vault-crypto/src"
  }
}
