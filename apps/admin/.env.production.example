# Production Environment Variables for Admin App

# API Configuration
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
INTERNAL_API_URL=http://api:3100

# Application Settings
NODE_ENV=production
PORT=3200
HOSTNAME=0.0.0.0

# CMS module: use the real CMS library API instead of in-browser mocks
# Admin do CMS fala com a API real por padrao. =true reativa a demo offline
# com dados falsos (util so para desenvolvimento sem backend).
# NEXT_PUBLIC_CMS_USE_MOCKS=true

# Notes:
# - NEXT_PUBLIC_API_BASE_URL: Public API URL used by the browser/admin
# - INTERNAL_API_URL: Server-side API URL used by Next.js inside Docker/K8s
# - For local development, NEXT_PUBLIC_API_BASE_URL can stay as /api
