{
  "version": 1,
  "include": [
    "*.json",
    "*.js",
    "*.yaml",
    "*.yml",
    "*.md",
    ".gitignore",
    ".dockerignore",
    ".actrc",
    ".nvmrc",
    ".node-version",
    ".env.example",
    ".eslintrc.js",
    ".prettierrc.js",
    "apps/.gitignore",
    "apps/admin/**",
    "apps/api/**",
    "packages/api/**",
    "packages/api-healthy/**",
    "packages/api-locale/**",
    "packages/api-mail/**",
    "packages/api-pagination/**",
    "packages/api-prisma/**",
    "packages/api-types/**",
    "packages/eslint-config/**",
    "packages/jest-config/**",
    "packages/next-app-provider/**",
    "packages/typescript-config/**",
    "packages/ui/**",
    "packages/vitest-config/**",
    "scripts/**",
    "test/**",
    "turbo/**",
    "docs/**",
    ".github/workflows/ci.yml",
    ".github/workflows/ci-e2e.yml",
    ".github/workflows/security.yml",
    ".github/agents/**",
    ".github/copilot-instructions.md",
    ".claude/commands/**",
    ".claude/settings.json",
    ".codex/subagents/**"
  ],
  "exclude": [
    "libraries/**",
    "apps/api/prisma/migrations/**",
    "apps/admin/public/libraries/**",
    "apps/admin/messages/*/**",
    "apps/admin/src/app/(app)/(libraries)/*/**",
    "apps/admin/src/components/widgets/*.*.*",
    "**/.env",
    "**/.env.*",
    "!**/.env.example",
    "apps/api/.example",
    ".npmrc",
    "**/.npmrc",
    ".mcp.json",
    "hedhog.json",
    "**/hedhog.json",
    "**/*.tsbuildinfo",
    "**/*.log",
    "**/jest.config.js",
    "**/jest.config.js.map",
    "**/jest.config.d.ts",
    "**/jest.config.d.ts.map",
    "**/tmp-*",
    "INTEGRATION_*.md",
    "DASHBOARD_*.md",
    "WIDGETS_*.md",
    "app.json",
    ".easignore",
    "apps/api/src/observability/**",
    "apps/api/src/instrument.ts",
    "apps/api/src/filters/*.sentry.spec.ts",
    "docs/sentry.md",
    "apps/api/src/legacy/**",
    "apps/api/src/brclick/**",
    "apps/api/scripts/**",
    "scripts/create-contact-tables.sql",
    "scripts/fix-certificate-template-background-fit.ts",
    "scripts/import-leaked-passwords.ts",
    "scripts/legacy-backfill-lesson-progress.ts",
    "scripts/resize-class-images.mjs",
    "scripts/resize-hero-image.mjs",
    "scripts/resize-login-banner.mjs",
    "scripts/restore-contact-frontend.js",
    "apps/admin/src/app/(auth)/secret-share/**",
    "apps/admin/src/lib/crypto/**",
    "packages/api-types/src/Vault*.ts",
    "packages/api-types/src/Secret*.ts",
    "packages/api-types/src/UserCrypto.ts",
    "packages/api-types/src/contracts/secret-health.ts",
    "apps/api/test/support/vaults-fixture.ts",
    "apps/api/test/vaults-security.e2e-spec.ts",
    "docs/vaults-publishing-pending.md",
    "packages/api-types/src/contracts/lms.ts",
    "docs/lms-decisoes-pendentes.md",
    "apps/api/test/commerce-payment-webhook.e2e-spec.ts",
    "apps/api/test/contact-reports.e2e-spec.ts",
    "apps/api/test/finance-reports.e2e-spec.ts",
    "apps/api/test/whatsapp-webhook.e2e-spec.ts",
    "apps/api/src/queue-definition.service.spec.ts",
    "apps/api/src/queue-worker.service.spec.ts"
  ],
  "preserve": [
    "bootstrap.sync.json",
    "apps/admin/src/components/widgets/_placeholder.tsx",
    "apps/admin/src/app/(app)/(libraries)/README.md",
    "apps/admin/src/components/README.widgets.md",
    "apps/api/src/app.module.ts",
    "apps/api/package.json",
    "**/.env",
    "**/.env.*"
  ],
  "sanitize": {
    "packages/typescript-config/base.json": "tsconfigPaths",
    "packages/typescript-config/nestjs.json": "tsconfigPaths",
    "packages/typescript-config/package.production.json": "tsconfigPaths",
    "apps/api/tsconfig.json": "tsconfigPaths",
    "apps/api/test/jest-e2e.json": "jestModuleMapper",
    "apps/api/prisma/schema.prisma": "prismaSchemaStub",
    "package.json": "libraryDependencies",
    "apps/admin/package.json": "libraryDependencies",
    "apps/api/package.json": "libraryDependencies",
    "apps/api/src/app.module.ts": "appModule"
  }
}
