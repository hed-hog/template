{
  "name": "@hed-hog/studio-edit-core",
  "version": "0.0.2",
  "license": "MIT",
  "description": "Núcleo da Ilha de Edição Inteligente: tempo em flicks, documento editorial, comandos, montagem e exportação. TypeScript puro — roda no Nest, no Electron e no browser.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "patch": "pnpm exec ts-node ../../scripts/patch.ts packages/studio-edit-core",
    "prod": "pnpm run patch && pnpm run build && pnpm publish --access public --no-git-checks"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@hed-hog/typescript-config": "workspace:*",
    "@types/node": "^24.9.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/index.d.ts"
      ]
    }
  }
}
