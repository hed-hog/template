{
  "name": "@hed-hog/api-mail",
  "version": "0.0.11",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1014.0",
    "@nestjs/axios": "*",
    "@nestjs/common": "*",
    "@nestjs/config": "*",
    "@nestjs/jwt": "*",
    "@nestjs/mapped-types": "*",
    "axios": "*",
    "bcrypt": "^5.1.1",
    "googleapis": "144.0.0",
    "imapflow": "^1.6.6",
    "mimemessage": "1.0.5",
    "nodemailer": "^7.0.11",
    "rxjs": "*",
    "@hed-hog/api-prisma": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/index.d.ts"
      ]
    }
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "@hed-hog/jest-config": "workspace:*"
  },
  "scripts": {
    "_dev": "pnpm build --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "prebuild": "pnpm --dir ../.. exec ts-node ./scripts/build-dependencies.ts packages/api-mail",
    "build": "tsc --project tsconfig.production.json",
    "patch": "pnpm exec ts-node ../../scripts/patch.ts packages/api-mail",
    "prod": "pnpm run patch && pnpm run build && pnpm publish --access public --no-git-checks",
    "test": "jest --config jest.config.ts --runInBand --passWithNoTests"
  }
}
