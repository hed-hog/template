{
  "extends": "@hed-hog/typescript-config/package.production.json",
  "include": [
    "src/**/*.ts"
  ],
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "jsx": "react-jsx",
    "tsBuildInfoFile": "./dist/tsconfig.production.tsbuildinfo"
  },
  "exclude": [
    "node_modules",
    "dist",
    ".turbo",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**",
    "jest.config.ts",
    "vitest.config.ts"
  ]
}
